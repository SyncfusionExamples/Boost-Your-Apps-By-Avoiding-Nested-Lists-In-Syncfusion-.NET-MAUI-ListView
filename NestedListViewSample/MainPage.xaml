<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NestedListViewSample.MainPage">

    <StackLayout>
        <Button x:Name="VerticalNestedListView" Text="Vertical List Inside VerticalListView" Clicked="VerticalNestedListView_Clicked"/>
        <Button x:Name="HorizontalNestedListView" Text="Horizontal List Inside VerticalListView" Clicked="HorizontalNestedListView_Clicked"/>
        <Button x:Name="GroupHeaders" Text="ListView With GroupHeaders" Clicked="GroupHeaders_Clicked"/>
        <Button x:Name="ExpandableListView" Text="Expandable ListView" Clicked="ExpandableListView_Clicked"/>
        <Button x:Name="Templatespage" Text="ListView with different Templates" Clicked="TemplatesPage_Clicked"/>
    </StackLayout>

</ContentPage>
