<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NestedListViewSample.VerticalListView"
             xmlns:local="clr-namespace:NestedListViewSample"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             Title="VerticalListView">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:MultiplyConverter x:Key="MultiplyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.BindingContext>
        <local:CatalogViewModel />
    </ContentPage.BindingContext>

    <!-- Vertical inside vertical (avoid scroll conflicts) -->
    <listView:SfListView ItemsSource="{Binding Categories}"
                         SelectionMode="None"
                         AutoFitMode="Height"
                         ItemSpacing="10">
        <listView:SfListView.ItemTemplate>
            <DataTemplate>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Name}"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <!-- Inner vertical SfListView:
                              1) Disable inner scrolling by giving exact height
                              2) Height = itemHeight * count (+ spacing/margins if needed)
                              3) Keep templates light for performance -->
                    <listView:SfListView ItemsSource="{Binding Products}"
                                         SelectionMode="None"
                                         AutoFitMode="None"
                                         ItemSpacing="6"
                                         IsScrollingEnabled="False"
                                         HeightRequest="{Binding Products.Count, Converter={StaticResource MultiplyConverter}, ConverterParameter=70}">
                        <listView:SfListView.ItemsLayout>
                            <listView:LinearLayout />
                        </listView:SfListView.ItemsLayout>

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="60,*,Auto"
                                      RowDefinitions="auto, 1"
                                      RowSpacing="3"
                                      HeightRequest="72"
                                      Padding="10">
                                    <Image Source="{Binding Image}"
                                               WidthRequest="56"
                                               HeightRequest="56"
                                               Aspect="AspectFit"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Clip="EllipseGeometry Center=28,28 RadiusX=28 RadiusY=28" />
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding Price, StringFormat='${0:F2}'}" TextColor="#2E7D32" />
                                    </VerticalStackLayout>
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="0.5" Color="Gray"/>
                                </Grid>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                </VerticalStackLayout>
            </DataTemplate>
        </listView:SfListView.ItemTemplate>
    </listView:SfListView>
</ContentPage>